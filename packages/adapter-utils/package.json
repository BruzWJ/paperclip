{
  "name": "@paperclipai/adapter-utils",
  "version": "0.3.1",
  "license": "MIT",
  "homepage": "https://github.com/paperclipai/paperclip",
  "bugs": {
    "url": "https://github.com/paperclipai/paperclip"
  },
  "repository": {
    "type": "git",
    "url": "https://github.com/paperclipai/paperclip",
    "directory": "packages/adapter-utils"
  },
  "type": "module",
  "exports": {
    ".": "./src/index.ts",
    "./acpx-runtime": "./src/acpx-runtime/index.ts",
    "./run-tools-stdio-proxy": "./src/run-tools-stdio-proxy.ts"
  },
  "publishConfig": {
    "access": "public",
    "exports": {
      ".": {
        "types": "./dist/index.d.ts",
        "import": "./dist/index.js"
      },
      "./acpx-runtime": {
        "types": "./dist/acpx-runtime/index.d.ts",
        "import": "./dist/acpx-runtime/index.js"
      },
      "./run-tools-stdio-proxy": {
        "types": "./dist/run-tools-stdio-proxy.d.ts",
        "import": "./dist/run-tools-stdio-proxy.js"
      }
    },
    "main": "./dist/index.js",
    "types": "./dist/index.d.ts"
  },
  "files": [
    "dist"
  ],
  "bundleDependencies": [
    "acpx",
    "zod"
  ],
  "scripts": {
    "build": "pnpm run clean && tsc",
    "clean": "rm -rf dist",
    "typecheck": "tsc --noEmit"
  },
  "dependencies": {
    "acpx": "0.13.0",
    "zod": "4.4.3"
  },
  "devDependencies": {
    "@agentclientprotocol/sdk": "1.3.0",
    "@types/node": "^22.19.21",
    "typescript": "^5.7.3"
  }
}

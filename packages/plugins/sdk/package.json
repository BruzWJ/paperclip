{
  "name": "@paperclipai/plugin-sdk",
  "version": "1.0.0",
  "description": "Stable public API for Paperclip plugins — worker-side context and UI bridge hooks",
  "license": "MIT",
  "homepage": "https://github.com/paperclipai/paperclip",
  "bugs": {
    "url": "https://github.com/paperclipai/paperclip"
  },
  "repository": {
    "type": "git",
    "url": "https://github.com/paperclipai/paperclip",
    "directory": "packages/plugins/sdk"
  },
  "type": "module",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    },
    "./ui": {
      "types": "./dist/ui/index.d.ts",
      "import": "./dist/ui/index.js"
    },
    "./testing": {
      "types": "./dist/testing.d.ts",
      "import": "./dist/testing.js"
    },
    "./bundlers": {
      "types": "./dist/bundlers.d.ts",
      "import": "./dist/bundlers.js"
    }
  },
  "publishConfig": {
    "access": "public",
    "main": "./dist/index.js",
    "types": "./dist/index.d.ts"
  },
  "files": [
    "dist"
  ],
  "scripts": {
    "build": "pnpm clean && pnpm --filter @paperclipai/shared build && tsc",
    "clean": "node -e \"require('node:fs').rmSync('dist',{recursive:true,force:true})\"",
    "ensure-build-deps": "node ../../../scripts/ensure-plugin-build-deps.mjs",
    "typecheck": "pnpm --filter @paperclipai/shared build && tsc --noEmit"
  },
  "dependencies": {
    "@paperclipai/shared": "workspace:*"
  },
  "devDependencies": {
    "@types/node": "^22.19.21",
    "@types/react": "^19.2.17",
    "typescript": "^5.7.3"
  },
  "peerDependencies": {
    "react": ">=18"
  },
  "peerDependenciesMeta": {
    "react": {
      "optional": true
    }
  }
}

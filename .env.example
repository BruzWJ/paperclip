# Required: point this at an already-running PostgreSQL server.
DATABASE_URL=

# Optional: HTTP port (default: 3100).
PORT=3100

# Public deployments only: set the canonical externally reachable HTTPS origin.
# Private/loopback instances derive their origin from the request and bind config.
# Better Auth/Next URL aliases are unsupported; PAPERCLIP_PUBLIC_URL is the only public URL input.
# PAPERCLIP_DEPLOYMENT_EXPOSURE=public
# PAPERCLIP_PUBLIC_URL=https://paperclip.example.com

# Required: generate once and store securely (for example, `openssl rand -hex 32`).
BETTER_AUTH_SECRET=

# Discord webhook for daily merge digest (scripts/discord-daily-digest.sh)
# DISCORD_WEBHOOK_URL=https://discord.com/api/webhooks/...

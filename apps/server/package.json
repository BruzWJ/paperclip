{
  "name": "@paperclipai/server",
  "version": "0.3.1",
  "license": "MIT",
  "homepage": "https://github.com/paperclipai/paperclip",
  "bugs": {
    "url": "https://github.com/paperclipai/paperclip"
  },
  "repository": {
    "type": "git",
    "url": "https://github.com/paperclipai/paperclip",
    "directory": "apps/server"
  },
  "type": "module",
  "exports": {
    ".": "./src/index.ts",
    "./worktree-bootstrap": "./src/dev-runner-worktree.ts"
  },
  "publishConfig": {
    "access": "public",
    "exports": {
      ".": {
        "types": "./dist/index.d.ts",
        "import": "./dist/index.js"
      },
      "./worktree-bootstrap": {
        "types": "./dist/dev-runner-worktree.d.ts",
        "import": "./dist/dev-runner-worktree.js"
      }
    },
    "main": "./dist/index.js",
    "types": "./dist/index.d.ts"
  },
  "files": [
    "dist",
    "ui-dist",
    "skills"
  ],
  "scripts": {
    "dev": "tsx src/runtime-entry.ts",
    "dev:watch": "tsx ./scripts/dev-watch.ts",
    "prepare:ui-dist": "bash ../../scripts/prepare-server-ui-dist.sh",
    "build": "pnpm run clean && tsc && mkdir -p dist/onboarding-assets && if [ -d src/onboarding-assets ]; then cp -R src/onboarding-assets/. dist/onboarding-assets/; fi",
    "prepack": "pnpm run prepare:ui-dist",
    "postpack": "rm -rf ui-dist",
    "clean": "rm -rf dist",
    "start": "node dist/runtime-entry.js",
    "typecheck": "pnpm --filter @paperclipai/plugin-sdk ensure-build-deps && tsc --noEmit"
  },
  "dependencies": {
    "@aws-sdk/client-s3": "^3.1075.0",
    "@modelcontextprotocol/sdk": "1.29.0",
    "@paperclipai/adapter-utils": "workspace:*",
    "@paperclipai/db": "workspace:*",
    "@paperclipai/plugin-sdk": "workspace:*",
    "@paperclipai/shared": "workspace:*",
    "@paperclipai/skills-catalog": "workspace:*",
    "ajv": "^8.20.0",
    "ajv-formats": "^3.0.1",
    "better-auth": "1.6.23",
    "chokidar": "^4.0.3",
    "detect-port": "^2.1.0",
    "dompurify": "^3.4.12",
    "dotenv": "^17.4.2",
    "drizzle-orm": "0.45.2",
    "effect": "4.0.0-beta.83",
    "express": "^5.1.0",
    "jsdom": "^28.1.0",
    "multer": "^2.2.0",
    "open": "^11.0.0",
    "pino": "^9.6.0",
    "pino-http": "^10.4.0",
    "pino-pretty": "^13.1.3",
    "sharp": "^0.35.3",
    "ws": "^8.21.1",
    "zod": "^3.24.2"
  },
  "devDependencies": {
    "@paperclipai/ui": "workspace:*",
    "@types/express": "^5.0.0",
    "@types/express-serve-static-core": "^5.0.0",
    "@types/jsdom": "^28.0.0",
    "@types/multer": "^2.2.0",
    "@types/node": "^22.19.21",
    "@types/sharp": "^0.32.0",
    "@types/supertest": "^6.0.2",
    "@types/ws": "^8.18.1",
    "cross-env": "^10.1.0",
    "supertest": "^7.0.0",
    "tsx": "^4.23.1",
    "typescript": "^5.7.3",
    "vite": "^6.1.0",
    "vitest": "^4.1.10"
  }
}
